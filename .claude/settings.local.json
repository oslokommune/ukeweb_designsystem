{
  "env": {
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(devbox *)",
      "Bash(docker exec *)",
      "Bash(docker compose *)",
      "Bash(docker-compose version *)"
    ],
    "deny": [
      "Bash(devbox -e *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Read(**.ssh/**)",
      "Read(.gnupg/**)",
      "Read(.devbox/**)",
      "Read(.aws/**)",
      "Read(.docker/config.json)",
      "Read(secrets**)",
      "Read(.secrets**)",
      "Read(.env)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(id_ecdsa*)",
      "Read(*.crt)",
      "Read(*.csr)"
    ]
  }
}
